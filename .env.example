# 二手车业务管理系统 — 环境变量示例（无真实密钥，仅占位）
# 复制为 .env 后按实际环境填写；.env 不要提交到仓库。

# 运行环境：development / demo / testing / production（默认 development）
APP_ENV=development

# 会话密钥：production 必填（未设置应用拒绝启动）；其他环境可不设（用内置演示密钥）
SECRET_KEY=请替换为强随机字符串_生产环境必填

# 数据库文件路径（默认 data/car_mgmt.db）；测试时指向临时文件
CAR_MGMT_DB_PATH=data/car_mgmt.db

# 初始管理员（仅 scripts/create_admin.py 使用）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请设置强密码
